# Groq API key — powers connection selection and timeline editorial (OpenAI-compatible).
# Get one at https://console.groq.com/keys
# WITHOUT this, Tapsa still runs end-to-end using heuristics and cleaned Wikipedia extracts.
GROQ_API_KEY=

# Optional: model for timeline editorial compression (defaults to llama-3.3-70b-versatile).
# TAPSA_TIMELINE_EDITORIAL_MODEL=llama-3.3-70b-versatile

# Optional: model for legacy timeline extraction (defaults to llama-3.1-8b-instant for higher rate limits).
# TAPSA_TIMELINE_MODEL=llama-3.1-8b-instant

# Optional: point at any OpenAI-compatible provider (Together, Fireworks,
# OpenRouter, Ollama, etc.). Defaults to Groq. Pair with TAPSA_LLM_API_KEY.
# TAPSA_LLM_BASE_URL=https://api.groq.com/openai/v1
# TAPSA_LLM_API_KEY=

# Optional: cold (uncached) generations allowed per IP per minute.
# TAPSA_COLD_LIMIT=8

# Public site URL — used for absolute OG image + share URLs in production.
# NEXT_PUBLIC_SITE_URL=https://www.tapsa.ai
